{
  "name": "pai-education-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit && wrangler types --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-types": "wrangler types",
    "db:create": "wrangler d1 create pai-platform",
    "db:migrate:local": "wrangler d1 migrations apply pai-platform --local",
    "db:migrate:remote": "wrangler d1 migrations apply pai-platform --remote",
    "db:seed:local": "wrangler d1 execute pai-platform --local --file=./scripts/seed.sql",
    "db:seed:remote": "wrangler d1 execute pai-platform --remote --file=./scripts/seed.sql",
    "db:bootstrap-admin:local": "node --env-file-if-exists=.dev.vars scripts/bootstrap-admin.mjs --local",
    "db:bootstrap-admin:remote": "node scripts/bootstrap-admin.mjs --remote"
  },
  "dependencies": {
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.8",
    "lucide-react": "^1.47.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.0",
    "wrangler": "^4.135.0"
  }
}
